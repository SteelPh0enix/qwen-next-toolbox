# Copy to .env and adjust. docker compose reads it automatically.

# Host directories, mounted into the container.
# Built stack (git checkouts, build trees, venv, generated launchers, HF cache). ~3 GiB.
STRIX_STATE_DIR=./state
# Where the .gguf weights live. ~96 GiB for Qwen3.8-Next-Flash.
STRIX_MODEL_DIR=./models
# Optional extra host directory mounted at /models-extra for weights already living elsewhere;
# point MODEL_FILE at a file inside it with an absolute /models-extra/... path. Empty = same as STRIX_MODEL_DIR.
STRIX_MODEL_DIR_EXTRA=

# Host port llama-server is published on.
STRIX_PORT=8080

# Parallel build jobs for the compile step.
JOBS=16

# Hugging Face token, only needed if the weight repository is gated.
HF_TOKEN=

# Container user. With rootless Docker leave it as root: container uid 0 is mapped to
# your host uid, so everything written into the mounts stays owned by you.
# With a rootful (system) daemon use: STRIX_USER=1000:100   # $(id -u):$(id -g)
STRIX_USER=root

# Host groups that own /dev/kfd and /dev/dri/renderD128:
#   getent group render video | cut -d: -f3
# Ignored when the container runs as root inside its own user namespace.
STRIX_RENDER_GID=303
STRIX_VIDEO_GID=26

# Shared memory for the container.
STRIX_SHM_SIZE=8g

# Weights to serve (see README section 9). Leave empty for the pinned set downloaded by
# ./pull-models.sh. A bare filename resolves under STRIX_MODEL_DIR; an absolute path must be
# mounted into the container. Use these to serve another quant or your own merge instead of
# the IQ4_NL shards - keep the pinned file names untouched if you want ./pull-models.sh to
# keep verifying them.
# Shard sets take the first shard: MODEL_FILE=My-Model-IQ4_XS-00001-of-00003.gguf
MODEL_FILE=
# MTP draft used for speculative decoding. `none` turns speculation off (use it when your
# weights have no matching draft). Empty = the pinned mtp-...-shared-Q8_0 draft.
DRAFT_MODEL=
# Vision projector (mmproj-F16.gguf, downloaded by ./pull-models.sh).
# `none` drops --mmproj entirely (text-only serving); a bare name resolves under STRIX_MODEL_DIR.
# Note: mmproj support is currently unstable (expect random crashes), and it's disabled by default for now.
MMPROJ_FILE=none
# Model name reported to API clients (--alias). Comma-separated to serve several names.
MODEL_ALIAS=Qwen 3.8 Flash Next

# Launcher knobs, passed to the server container (see README section 10).
CTX_SIZE=262144
BATCH_SIZE=16384
UBATCH_SIZE=16384
PARALLEL=1
MTP_N_MAX=3
ENABLE_RETAINED_PM4=1
# Keeps the APU from sitting at max clock while idle.
GPU_MAX_HW_QUEUES=1
